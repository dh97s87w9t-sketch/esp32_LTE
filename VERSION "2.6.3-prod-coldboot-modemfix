  size_t n = serializeJson(doc, buffer, sizeof(buffer));
  mqttClient.publish(MQTT_TOPIC_STATUS, (uint8_t*)buffer, n, true);
}

// ---------------- AT helpers ----------------
bool sendATWithTimeout(String cmd, String expectedResponse, unsigned long timeout = AT_COMMAND_TIMEOUT) {
  SerialAT.println(cmd);
  unsigned long start = millis();
  String response; response.reserve(256);
  while (!timePassed(millis(), start, timeout)) {
    while (SerialAT.available()) {
      char c = (char)SerialAT.read();
      if (response.length() < 512) response += c;
      if (response.indexOf(expectedResponse) != -1) return true;
      if (response.indexOf("ERROR") != -1) return false;
    }
    delay(10);
  }
  return false;
}

void sendATGetResponse(String cmd, String &response, unsigned long timeout = AT_COMMAND_TIMEOUT) {
  SerialAT.println(cmd);
  response = ""; response.reserve(1024);
  unsigned long start = millis();
  while (!timePassed(millis(), start, timeout)) {
    while (SerialAT.available()) {
      char c = (char)SerialAT.read();
      if (response.length() < 2048) response += c;
    }
    delay(10);
  }
  response.trim();
}

// ---- cold boot modem helpers ----
static void modemPwrkeyIdleHigh() {
  pinMode(MODEM_PWRKEY, OUTPUT);
  digitalWrite(MODEM_PWRKEY, HIGH);
  delay(50);
}

static void modemPwrkeyPulseOn() {
  // typowo A7670: PWRKEY aktywne LOW (przycisk do GND) – Twoja sekwencja była taka sama
  digitalWrite(MODEM_PWRKEY, HIGH);
  delay(100);
  digitalWrite(MODEM_PWRKEY, LOW);
  delay(MODEM_PWRKEY_PULSE_MS);
  digitalWrite(MODEM_PWRKEY, HIGH);
}

static bool modemATProbe(unsigned long probeMs) {
  unsigned long start = millis();
  while (!timePassed(millis(), start, probeMs)) {
    if (sendATWithTimeout("AT", "OK", 800)) return true;
    delay(200);
    feedWatchdog();
  }
  return false;
}

static void modemEmergencyResetIfAvailable() {
  if (MODEM_RESET_N < 0) return;
  pinMode(MODEM_RESET_N, OUTPUT);
  digitalWrite(MODEM_RESET_N, HIGH);
  delay(50);
  digitalWrite(MODEM_RESET_N, LOW);
  delay(2600); // SIMCom często zaleca ~2.5s jako reset pulse [web:353]
  digitalWrite(MODEM_RESET_N, HIGH);
  delay(200);
}

// ---------------- Modem ----------------
void setupAndOptionallyCleanSmsStorage() {
  sendATWithTimeout("AT+CPMS=\"SM\",\"SM\",\"SM\"", "OK", 3000);
  if (SMS_STORAGE_CLEAN_ON_BOOT) sendATWithTimeout("AT+CMGD=1,4", "OK", 8000);
  String r; sendATGetResponse("AT+CPMS?", r, 2000);
  if (r.length() > 0) LOG("CPMS: " + r);
}

void checkModemFirmware() {
  String r;
  sendATGetResponse("AT+CGMM", r, 1500);
  if (r.length() > 0) LOG("Model: " + r);
  sendATGetResponse("AT+GSN", r, 1500);
  if (r.length() > 0) LOG("IMEI: " + r);
}

bool checkSignalQuality() {
  String response;
  sendATGetResponse("AT+CSQ", response, 1500);
  int csqIdx = response.indexOf("+CSQ:");
  if (csqIdx != -1) {
    int colon = response.indexOf(":", csqIdx);
    int comma = response.indexOf(",", csqIdx);
    if (colon != -1 && comma != -1 && comma > colon) {
      String v = response.substring(colon + 1, comma);
      v.trim();
      signalStrength = v.toInt();
      if (signalStrength != 99) signalQuality = -113 + (signalStrength * 2);
      else signalQuality = -999;
      return (signalStrength >= SIGNAL_THRESHOLD && signalStrength != 99);
    }
  }
  return false;
}

bool checkModemHealth() { return sendATWithTimeout("AT", "OK", 3000); }

void initModem() {
  SerialAT.setRxBufferSize(4096);
  SerialAT.begin(115200, SERIAL_8N1, MODEM_RX, MODEM_TX);

  LOG("Init A7670E modem...");

  modemPwrkeyIdleHigh();

  // 1) Zimny start: najpierw sprawdź czy już żyje (czasem modem sam startuje po VBAT)
  if (!modemATProbe(MODEM_BOOT_PROBE_MS)) {
    // 2) Jeśli cisza: próbuj power-on pulsem PWRKEY kilka razy
    for (int i = 0; i < MODEM_POWERON_TRIES; i++) {
      LOG("Modem power-on attempt " + String(i + 1) + "/" + String(MODEM_POWERON_TRIES));
      modemPwrkeyPulseOn();
      LOG("Waiting " + String(MODEM_AFTER_PULSE_WAIT_MS) + "ms for modem boot...");
      unsigned long w = millis();
      while (!timePassed(millis(), w, MODEM_AFTER_PULSE_WAIT_MS)) { delay(50); feedWatchdog(); }
      if (modemATProbe(MODEM_BOOT_PROBE_MS)) break;
    }
  }

  // 3) Ostatecznie: emergency reset (jeśli pin masz podpięty) i ostatnia próba AT
  if (!sendATWithTimeout("AT", "OK", 1500)) {
    LOG("✗ Modem not responding");
    publishDiag("modem", "no AT response after coldboot tries");
    modemEmergencyResetIfAvailable();
    if (!modemATProbe(8000)) {
      modemReady = false;
      return;
    }
  }

  // normal init
  sendATWithTimeout("ATE0", "OK", 2000);
  sendATWithTimeout("AT+CMEE=2", "OK", 2000);

  checkModemFirmware();

  sendATWithTimeout("AT+CSCLK=0", "OK", 2000);
  sendATWithTimeout("AT+CPIN?", "OK", 3000);
  sendATWithTimeout("AT+CREG?", "OK", 3000);

  checkSignalQuality();

  sendATWithTimeout("AT+CMGF=1", "OK", 2000);
  sendATWithTimeout("AT+CSCS=\"GSM\"", "OK", 2000);
  sendATWithTimeout("AT+CTZU=1", "OK", 2000);
  sendATWithTimeout("AT+CSMP=17,167,0,0", "OK", 2000);

  setupAndOptionallyCleanSmsStorage();
  sendATWithTimeout("AT+CNMI=2,2,0,0,0", "OK", 2000);

  modemReady = true;
  LOG("✓ Modem ready!");
  publishStatus();
}

void resetModem() {
  LOG("═══ MODEM RESET ═══");
  modemReady = false;
  modemEmergencyResetIfAvailable();
  initModem();
}

// ---------------- SMS send ----------------
static inline int extractCmsError(const String &resp) {
  int p = resp.indexOf("+CMS ERROR:");
  if (p == -1) return -1;
  int colon = resp.indexOf(":", p);
  if (colon == -1) return -1;
  String v = resp.substring(colon + 1);
  v.trim();
  return v.toInt();
}
static inline String tailStr(const String &s, int maxLen) {
  if ((int)s.length() <= maxLen) return s;
  return s.substring(s.length() - maxLen);
}
static inline void ensureSmsMode() {
  sendATWithTimeout("AT+CMEE=2", "OK", 1500);
  sendATWithTimeout("AT+CMGF=1", "OK", 1500);
  sendATWithTimeout("AT+CSCS=\"GSM\"", "OK", 1500);
}

bool sendSMS(String number, String message) {
  lastSendWasUncertain = false;
  LOG("▶ Sending SMS to " + number);

  ensureSmsMode();

  SerialAT.print("AT+CMGS=\""); SerialAT.print(number); SerialAT.println("\"");

  unsigned long start = millis();
  bool promptReceived = false;
  while (!timePassed(millis(), start, 6000)) {
    while (SerialAT.available()) {
      char c = (char)SerialAT.read();
      if (c == '>') { promptReceived = true; break; }
    }
    if (promptReceived) break;
    delay(10);
  }
  if (!promptReceived) { LOG("✗ No '>' prompt"); publishDiag("sms", "no_prompt"); return false; }

  SerialAT.print(message);
  SerialAT.write(26);

  start = millis();
  String response; response.reserve(512);
  bool gotCMGS = false, gotOK = false;

  while (!timePassed(millis(), start, SMS_SEND_TIMEOUT)) {
    while (SerialAT.available()) {
      char c = (char)SerialAT.read();
      if (response.length() < 1400) response += c;

      if (!gotCMGS && response.indexOf("+CMGS:") != -1) gotCMGS = true;
      if (!gotOK && (response.indexOf("\nOK") != -1 || response.endsWith("OK"))) gotOK = true;

      int cms = extractCmsError(response);
      if (cms != -1) { publishDiag("sms", "+CMS ERROR " + String(cms) + " tail=" + tailStr(response, 220)); return false; }
      if (response.indexOf("ERROR") != -1) { publishDiag("sms", "ERROR tail=" + tailStr(response, 220)); return false; }

      if (gotCMGS && gotOK) { LOG("✓ SMS sent successfully (+CMGS + OK)"); delay(SMS_COOLDOWN_MS); return true; }
    }
    delay(10);
  }

  smsSentUncertain++;
  publishDiag("sms", "uncertain timeout tail=" + tailStr(response, 220));
  return false;
}

// ---------------- Queue persistence ----------------
void saveSMSQueue() {
  preferences.begin("sms-gateway", false);
  for (int i = 0; i < SMS_QUEUE_SIZE; i++) {
    String key = "sms_" + String(i);
    if (smsQueue[i].pending && smsQueue[i].retries == 0) {
      String data = smsQueue[i].phone + "|" + smsQueue[i].message + "|0";
      preferences.putString(key.c_str(), data);
    } else {
      if (smsQueue[i].pending && smsQueue[i].retries > 0) smsDroppedFromNVS++;
      preferences.remove(key.c_str());
    }
  }
  preferences.end();
}

void loadSMSQueue() {
  preferences.begin("sms-gateway", true);
  for (int i = 0; i < SMS_QUEUE_SIZE; i++) {
    String key = "sms_" + String(i);
    String data = preferences.getString(key.c_str(), "");
    if (data.length() > 0) {
      int sep1 = data.indexOf("|");
      int sep2 = data.indexOf("|", sep1 + 1);
      if (sep1 != -1 && sep2 != -1 && sep2 > sep1) {
        smsQueue[i] = { data.substring(0, sep1), data.substring(sep1 + 1, sep2), true, data.substring(sep2 + 1).toInt(), 0UL };
      } else {
        smsQueue[i] = {"","",false,0,0};
      }
    } else {
      smsQueue[i] = {"","",false,0,0};
    }
  }
  preferences.end();
  rebuildQueuePointers();
}

bool addSMSToQueue(String phone, String message) {
  if (isSMSDuplicate(phone, message)) return false;
  int freeIdx = findFreeSlot();
  if (freeIdx < 0) return false;

  smsQueue[freeIdx] = { phone, message, true, 0, 0UL };
  addToSMSCache(phone, message);

  saveSMSQueue();
  rebuildQueuePointers();

  lastTxProgressMs = millis();
  LOG("✓ Added 1 SMS to queue (pending=" + String(getPendingCount()) + ")");
  return true;
}

// ---------------- TX watchdog / send ----------------
void txWatchdogAndDiag(unsigned long now) {
  int pending = getPendingCount();
  if (!modemReady || pending == 0) return;

  if (timePassed(now, lastTxBlockLogMs, TX_BLOCK_LOG_MS)) {
    int head = findNextPendingFrom(smsQueueHead);
    unsigned long ageSec = (lastTxProgressMs == 0) ? 0 : (elapsedMs(now, lastTxProgressMs) / 1000);
    LOG("TX diag: pending=" + String(pending) + " head=" + String(head) + " CSQ=" + String(signalStrength) + " lastProgress=" + String(ageSec) + "s");
    lastTxBlockLogMs = now;
  }

  if (lastTxProgressMs != 0 && timePassed(now, lastTxProgressMs, TX_STUCK_RESET_MS)) {
    LOG("⚠ TX stuck -> resetting modem");
    resetModem();
    lastTxProgressMs = now;
  }
}

void processSMSQueue() {
  int idx = findNextPendingFrom(smsQueueHead);
  if (idx < 0) return;

  unsigned long now = millis();
  if (smsQueue[idx].lastAttempt != 0 && !timePassed(now, smsQueue[idx].lastAttempt, SMS_MIN_RETRY_DELAY_MS)) return;

  if (signalStrength == 99 || signalStrength < SIGNAL_THRESHOLD) {
    LOG("⚠ TX blocked: CSQ=" + String(signalStrength));
    return;
  }

  bool ok = sendSMS(smsQueue[idx].phone, smsQueue[idx].message);

  if (ok) {
    smsSentSuccess++;
    smsQueue[idx].pending = false;
    lastTxProgressMs = now;
    saveSMSQueue();
    rebuildQueuePointers();
  } else {
    smsQueue[idx].retries++;
    smsQueue[idx].lastAttempt = now;
    if (smsQueue[idx].retries >= SMS_MAX_RETRIES) {
      smsSentFailed++;
      smsQueue[idx].pending = false;
      lastTxProgressMs = now;
      saveSMSQueue();
      rebuildQueuePointers();
    }
  }

  lastSMSSent = now;
  publishStatus();
}

// ---------------- health ----------------
void checkHeapMemory() {
  if (ESP.getFreeHeap() < 50000) LOG("⚠ LOW HEAP: " + String(ESP.getFreeHeap()));
}

// ================== SETUP/LOOP ==================
void setup() {
  setCpuFrequencyMhz(100);
  Serial.begin(115200);
  delay(1000);

  printResetReason();

  esp_task_wdt_deinit();
  esp_task_wdt_config_t wdt_config = {.timeout_ms=WDT_TIMEOUT,.idle_core_mask=(1<<0),.trigger_panic=true};
  esp_err_t wdt_result = esp_task_wdt_init(&wdt_config);
  if (wdt_result == ESP_OK || wdt_result == ESP_ERR_INVALID_STATE) {
    esp_task_wdt_add(NULL);
    watchdogEnabled = true;
    LOG("✓ Watchdog enabled");
  }

  for (int i = 0; i < SMS_CACHE_SIZE; i++) smsCache[i].active = false;
  for (int i = 0; i < INCOMING_SMS_CACHE_SIZE; i++) incomingSMSCache[i].active = false;
  for (int i = 0; i < SMS_QUEUE_SIZE; i++) smsQueue[i] = {"","",false,0,0};

  loadSMSQueue();

  setupWiFi();
  setupMQTT();
  mqttReconnect();

  initModem();

  lastModemCheck = millis();
  lastHeapCheck = millis();
  lastSMSSent = millis();
  lastSignalCheck = millis();
  lastLogCleanup = millis();
  lastTxProgressMs = millis();
  lastTxBlockLogMs = millis();

  LOG("SYSTEM READY");
}

void loop() {
  unsigned long now = millis();
  feedWatchdog();

  if (mqttClient.connected()) mqttClient.loop();

  if (WiFi.status() != WL_CONNECTED) setupWiFi();

  if (!mqttClient.connected()) {
    if (timePassed(now, lastMQTTReconnect, MQTT_RECONNECT_INTERVAL)) {
      mqttReconnect();
      lastMQTTReconnect = now;
    }
  }

  if (modemReady && timePassed(now, lastModemCheck, MODEM_CHECK_INTERVAL)) {
    if (!checkModemHealth()) resetModem();
    lastModemCheck = now;
  }

  if (modemReady && timePassed(now, lastSignalCheck, SIGNAL_CHECK_INTERVAL)) {
    checkSignalQuality();
    lastSignalCheck = now;
  }

  if (modemReady && getPendingCount() > 0 && timePassed(now, lastSMSSent, SMS_SEND_DELAY)) {
    processSMSQueue();
  }

  txWatchdogAndDiag(now);

  if (timePassed(now, lastHeapCheck, HEAP_CHECK_INTERVAL)) {
    checkHeapMemory();
    cleanupSMSCache();
    cleanupIncomingSMSCache();
    lastHeapCheck = now;
  }

  if (timePassed(now, lastLogCleanup, LOG_CLEANUP_INTERVAL)) {
    cleanupLogBuffer();
    lastLogCleanup = now;
  }

  delay(5);
}

