// ---------------- Queue ----------------
int getPendingCount() { int c=0; for(int i=0;i<SMS_QUEUE_SIZE;i++) if(smsQueue[i].pending) c++; return c; }
int findNextPendingFrom(int startIdx){ for(int k=0;k<SMS_QUEUE_SIZE;k++){int i=(startIdx+k)%SMS_QUEUE_SIZE; if(smsQueue[i].pending) return i;} return -1; }
int findFreeSlot(){ for(int i=0;i<SMS_QUEUE_SIZE;i++) if(!smsQueue[i].pending) return i; return -1; }
void rebuildQueuePointers(){ int first=findNextPendingFrom(0); if(first==-1){smsQueueHead=0;smsQueueTail=0;return;} smsQueueHead=first; smsQueueTail=(first+1)%SMS_QUEUE_SIZE; }

// ---------------- Dedup ----------------
bool isSMSDuplicate(String phone, String message) {
  unsigned long now = millis();
  for (int i=0;i<SMS_CACHE_SIZE;i++) {
    if (smsCache[i].active && smsCache[i].phone==phone && smsCache[i].message==message) {
      if (!timePassed(now, smsCache[i].timestamp, SMS_DEDUP_TIME)) { smsDuplicatesBlocked++; return true; }
    }
  }
  return false;
}
void addToSMSCache(String phone, String message){ smsCache[smsCacheIndex]={phone,message,millis(),true}; smsCacheIndex=(smsCacheIndex+1)%SMS_CACHE_SIZE; }
bool isNumberAllowed(String number){ number.trim(); number.replace(" ",""); for(int i=0;i<ALLOWED_NUMBERS_COUNT;i++) if(number==ALLOWED_NUMBERS[i]) return true; return false; }
bool isIncomingSMSDuplicate(String sender, String message){
  unsigned long now=millis();
  for(int i=0;i<INCOMING_SMS_CACHE_SIZE;i++){
    if(incomingSMSCache[i].active && incomingSMSCache[i].sender==sender && incomingSMSCache[i].message==message){
      if(!timePassed(now,incomingSMSCache[i].timestamp,INCOMING_SMS_DEDUP_TIME)){ incomingDuplicatesBlocked++; return true; }
    }
  }
  return false;
}
void addToIncomingSMSCache(String sender,String message){ incomingSMSCache[incomingSMSCacheIndex]={sender,message,millis(),true}; incomingSMSCacheIndex=(incomingSMSCacheIndex+1)%INCOMING_SMS_CACHE_SIZE; }
void cleanupSMSCache(){ unsigned long now=millis(); for(int i=0;i<SMS_CACHE_SIZE;i++) if(smsCache[i].active && timePassed(now,smsCache[i].timestamp,SMS_DEDUP_TIME)) smsCache[i].active=false; }
void cleanupIncomingSMSCache(){ unsigned long now=millis(); for(int i=0;i<INCOMING_SMS_CACHE_SIZE;i++) if(incomingSMSCache[i].active && timePassed(now,incomingSMSCache[i].timestamp,INCOMING_SMS_DEDUP_TIME)) incomingSMSCache[i].active=false; }

// ---------------- WiFi ----------------
void setupWiFi() {
  LOG("WiFi connecting to: " + String(WIFI_SSID));
  WiFi.persistent(false);
  WiFi.setAutoReconnect(true);
  WiFi.mode(WIFI_STA);
  WiFi.disconnect();
  delay(100);

  if (USE_STATIC_IP) {
    IPAddress ip, gateway, subnet, dns1, dns2;
    ip.fromString(STATIC_IP);
    gateway.fromString(GATEWAY);
    subnet.fromString(SUBNET);
    dns1.fromString(DNS_PRIMARY);
    dns2.fromString(DNS_SECONDARY);
    WiFi.config(ip, gateway, subnet, dns1, dns2);
    LOG("Static IP: " + String(STATIC_IP));
  }

  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 30) {
    delay(500);
    Serial.print(".");
    attempts++;
    if (attempts % 5 == 0) feedWatchdog();
  }
  Serial.println();

  if (WiFi.status() == WL_CONNECTED) {
    LOG("✓ WiFi connected!");
    LOG("IP: " + WiFi.localIP().toString());
    LOG("RSSI: " + String(WiFi.RSSI()) + " dBm");
  } else {
    LOG("✗ WiFi failed - restarting ESP32");
    delay(200);
    ESP.restart();
  }
}

// ---------------- MQTT ----------------
void publishDiscovery();
void publishStatus();
bool addSMSToQueue(String phone, String message);

void mqttCallback(char* topic, byte* payload, unsigned int length) {
  if (length > 700) { LOG("✗ MQTT message too large"); return; }
  StaticJsonDocument<768> doc;
  if (deserializeJson(doc, payload, length)) { LOG("✗ JSON parse error"); return; }

  if (String(topic) == MQTT_TOPIC_SEND) {
    String message = doc["message"] | "";
    if (message.length() == 0) return;

    if (doc.containsKey("phone")) {
      String phone = doc["phone"] | "";
      if (phone.length() > 0) addSMSToQueue(phone, message);
      publishStatus();
    } else if (doc.containsKey("phones")) {
      JsonArray phones = doc["phones"];
      for (JsonVariant v : phones) {
        String phone = v.as<String>();
        if (phone.length() > 0) addSMSToQueue(phone, message);
      }
      publishStatus();
    }
  }
}

void setupMQTT() {
  mqttClient.setBufferSize(MQTT_MAX_PACKET_SIZE);
  mqttClient.setKeepAlive(MQTT_KEEPALIVE_SEC);
  mqttClient.setSocketTimeout(MQTT_SOCKET_TIMEOUT_SEC);
  mqttClient.setServer(MQTT_BROKER, MQTT_PORT);
  mqttClient.setCallback(mqttCallback);
}

void mqttReconnect() {
  if (WiFi.status() != WL_CONNECTED) return;
  if (mqttClient.connected()) return;

  LOG("MQTT connecting to " + String(MQTT_BROKER) + "...");
  const char* lwt = "{\"state\":\"offline\"}";
  bool ok = mqttClient.connect(DEVICE_ID, MQTT_USER, MQTT_PASSWORD, MQTT_TOPIC_STATUS, 1, true, lwt);

  if (ok) {
    LOG("✓ MQTT connected!");
    mqttClient.subscribe(MQTT_TOPIC_SEND, 1);
    LOG("✓ Subscribed to: " + String(MQTT_TOPIC_SEND));
    publishDiscovery();
    publishStatus();
  } else {
    LOG("✗ MQTT failed rc=" + String(mqttClient.state()));
  }
}

void publishDiscovery() {
  StaticJsonDocument<512> doc;
  doc["name"] = "ESP32 SMS Gateway";
  doc["unique_id"] = DEVICE_ID;
  doc["command_topic"] = MQTT_TOPIC_SEND;
